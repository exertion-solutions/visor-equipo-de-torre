# dependencias y build
node_modules/
dist/
*.tsbuildinfo
coverage/

# secretos
.env
.env.*
!.env.example

# caches de herramientas
.vite/
.eslintcache
.cache/
.tmp/
.turbo/
*.log
npm-debug.log*

# Claude Code: config local (nunca versionar)
.claude/settings.local.json
.claude/*.local.*

# sistema / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# modelos 3D originales pesados (se versionan solo los optimizados en public/models/)
assets/source/**
!assets/source/README.md
!assets/source/.gitkeep

# artefactos de Playwright MCP
.playwright-mcp/

# salidas temporales de build/capturas

# documentos de terceros marcados "YPF-Privado": se quedan en el disco, no en git
**/Taller de Aseguramiento*.pdf
**/Upstream YPF*.pdf

# documentos internos de Tacker (PDF fuente y sus capturas): quedan en el disco, no en el repo publico
docs/fuentes/**/*.pdf
docs/pdf-review/pages/

# Fotos de referencia de terceros (origen/licencia sin verificar): solo en copia local
docs/references/*/*.jpg
docs/references/*/*.jpeg
docs/references/*/*.webp
docs/references/*/*.avif
docs/references/enganche/*.png

# worktrees de agentes
.claude/worktrees/
__pycache__/
*.pyc

# documentos y fotos sueltos en la raíz (planos TACKER, imágenes de terceros): nunca al repo público
**/*.pdf
**/*.PDF
# excepciones puntuales que sí deban subirse: !ruta/archivo.pdf
/*.avif
# imagen de catálogo de proveedor (marca de agua): solo local, la usa iou.py
cad/examples/choke_manifold_ilustrativo/ref.png
